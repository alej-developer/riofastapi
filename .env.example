# Plantilla de variables de entorno para Rio API.
# Copiar y editar en local (el archivo .env no se versiona):
#   cp .env.example .env
#
# En desarrollo la aplicacion funciona con los valores por defecto
# de app/core/config.py. No pongas secretos reales en este archivo.

# Modo de ejecucion. Con "produccion" se activan HSTS y la CSP estricta.
ENTORNO=desarrollo

# Puerto de escucha. En local el valor habitual es 8000.
# Cloud Run inyecta 8080; el Dockerfile usa PORT al arrancar uvicorn.
PORT=8000

# Clave para firmar tokens JWT. Cambiarla de forma obligatoria en produccion.
# En Cloud Run debe venir de Secret Manager, no de un archivo dentro de la imagen.
CLAVE_SECRETA=cambia-esta-clave-en-produccion-es-muy-importante

# Algoritmo de firma de los tokens.
ALGORITMO_JWT=HS256

# Duracion de los tokens de acceso, en minutos.
MINUTOS_EXPIRACION_TOKEN=30
